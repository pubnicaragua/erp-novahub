generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== ENUMS =====

enum SystemRole {
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DocumentStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CARD
  OTHER
}

enum Frequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  PENDING
  RECEIVED
  PARTIAL
  REJECTED
}

enum ReturnStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOIDED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum JournalStatus {
  DRAFT
  POSTED
  VOIDED
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum SalaryType {
  MONTHLY
  BIWEEKLY
  HOURLY
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum TimeOffType {
  VACATION
  SICK_LEAVE
  PERSONAL
  MATERNITY
  UNPAID
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  DEADLINE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// ===== MODELS =====

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  logo         String?
  primaryColor String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]

  customers Customer[]

  suppliers Supplier[]
}

model User {
  id           String     @id @default(uuid())
  tenantId     String
  email        String     @unique
  passwordHash String
  name         String
  avatar       String?
  role         SystemRole @default(EMPLOYEE)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  activities Activity[]
}

model Customer {
  id           String       @id @default(uuid())
  tenantId     String
  code         String
  name         String
  type         CustomerType @default(COMPANY)
  taxId        String?
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  creditLimit  Decimal      @default(0)
  balance      Decimal      @default(0)
  status       EntityStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  estimates Estimate[]

  salesOrders SalesOrder[]

  invoices Invoice[]

  paymentsReceived  PaymentReceived[]
  recurringInvoices RecurringInvoice[]
}

model Estimate {
  id             String         @id @default(uuid())
  tenantId       String
  number         String         @unique
  customerId     String
  date           DateTime
  expiryDate     DateTime
  subtotal       Decimal
  taxAmount      Decimal
  discountAmount Decimal        @default(0)
  total          Decimal
  currency       String         @default("USD")
  status         DocumentStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  items EstimateItem[]
}

model EstimateItem {
  id          String  @id @default(uuid())
  estimateId  String
  productId   String?
  description String
  quantity    Decimal
  unitPrice   Decimal
  taxRate     Decimal @default(0)
  discount    Decimal @default(0)
  total       Decimal

  estimate Estimate @relation(fields: [estimateId], references: [id])
}

model SalesOrder {
  id               String           @id @default(uuid())
  tenantId         String
  number           String           @unique
  customerId       String
  estimateId       String?
  date             DateTime
  expectedDelivery DateTime?
  subtotal         Decimal
  taxAmount        Decimal
  discountAmount   Decimal          @default(0)
  total            Decimal
  currency         String           @default("USD")
  status           SalesOrderStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  items SalesOrderItem[]

  invoices Invoice[]
}

model SalesOrderItem {
  id           String  @id @default(uuid())
  salesOrderId String
  productId    String?
  description  String
  quantity     Decimal
  unitPrice    Decimal
  taxRate      Decimal @default(0)
  discount     Decimal @default(0)
  total        Decimal

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  number         String        @unique
  customerId     String
  salesOrderId   String?
  date           DateTime
  dueDate        DateTime
  subtotal       Decimal
  taxAmount      Decimal
  discountAmount Decimal       @default(0)
  total          Decimal
  amountPaid     Decimal       @default(0)
  balance        Decimal
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])

  items InvoiceItem[]

  payments PaymentReceived[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal
  unitPrice   Decimal
  taxRate     Decimal @default(0)
  discount    Decimal @default(0)
  total       Decimal

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model RecurringInvoice {
  id              String          @id @default(uuid())
  tenantId        String
  customerId      String
  frequency       Frequency
  startDate       DateTime
  endDate         DateTime?
  nextInvoiceDate DateTime
  subtotal        Decimal
  taxAmount       Decimal
  total           Decimal
  currency        String          @default("USD")
  status          RecurringStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  items RecurringInvoiceItem[]
}

model RecurringInvoiceItem {
  id                 String  @id @default(uuid())
  recurringInvoiceId String
  productId          String?
  description        String
  quantity           Decimal
  unitPrice          Decimal
  taxRate            Decimal @default(0)
  total              Decimal

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id])
}

model PaymentReceived {
  id         String        @id @default(uuid())
  tenantId   String
  number     String        @unique
  customerId String
  invoiceId  String?
  date       DateTime
  amount     Decimal
  currency   String        @default("USD")
  method     PaymentMethod
  reference  String?
  notes      String?
  createdAt  DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
}

model SalesReturn {
  id         String       @id @default(uuid())
  tenantId   String
  number     String       @unique
  customerId String
  invoiceId  String
  date       DateTime
  total      Decimal
  reason     String
  status     ReturnStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  items SalesReturnItem[]
}

model SalesReturnItem {
  id            String  @id @default(uuid())
  salesReturnId String
  productId     String?
  description   String
  quantity      Decimal
  unitPrice     Decimal
  total         Decimal

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id])
}

model CreditNote {
  id            String           @id @default(uuid())
  tenantId      String
  number        String           @unique
  customerId    String
  invoiceId     String?
  salesReturnId String?
  date          DateTime
  total         Decimal
  status        CreditNoteStatus @default(DRAFT)
  reason        String
  createdAt     DateTime         @default(now())

  items CreditNoteItem[]
}

model CreditNoteItem {
  id           String  @id @default(uuid())
  creditNoteId String
  description  String
  quantity     Decimal
  unitPrice    Decimal
  total        Decimal

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id])
}

model Supplier {
  id           String       @id @default(uuid())
  tenantId     String
  code         String
  name         String
  taxId        String?
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String?
  contactName  String?
  paymentTerms String?
  balance      Decimal      @default(0)
  rating       Decimal      @default(0)
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  purchaseOrders PurchaseOrder[]

  supplierInvoices SupplierInvoice[]
  paymentMades     PaymentMade[]
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  tenantId         String
  number           String              @unique
  supplierId       String
  date             DateTime
  expectedDelivery DateTime?
  subtotal         Decimal
  taxAmount        Decimal
  total            Decimal
  currency         String              @default("USD")
  status           PurchaseOrderStatus @default(DRAFT)
  requestedBy      String
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseOrderItem[]

  receipts PurchaseReceipt[]
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  productId       String?
  description     String
  quantity        Decimal
  unitPrice       Decimal
  taxRate         Decimal @default(0)
  total           Decimal

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model PurchaseReceipt {
  id              String        @id @default(uuid())
  tenantId        String
  number          String        @unique
  purchaseOrderId String
  supplierId      String
  date            DateTime
  status          ReceiptStatus @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  items PurchaseReceiptItem[]
}

model PurchaseReceiptItem {
  id                String  @id @default(uuid())
  purchaseReceiptId String
  productId         String?
  description       String
  quantityOrdered   Decimal
  quantityReceived  Decimal

  purchaseReceipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id])
}

model SupplierInvoice {
  id              String        @id @default(uuid())
  tenantId        String
  number          String        @unique
  supplierId      String
  purchaseOrderId String?
  date            DateTime
  dueDate         DateTime
  subtotal        Decimal
  taxAmount       Decimal
  total           Decimal
  amountPaid      Decimal       @default(0)
  balance         Decimal
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items SupplierInvoiceItem[]
}

model SupplierInvoiceItem {
  id                String  @id @default(uuid())
  supplierInvoiceId String
  description       String
  quantity          Decimal
  unitPrice         Decimal
  taxRate           Decimal @default(0)
  total             Decimal

  supplierInvoice SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id])
}

model RecurringSupplierInvoice {
  id              String          @id @default(uuid())
  tenantId        String
  supplierId      String
  frequency       Frequency
  startDate       DateTime
  endDate         DateTime?
  nextInvoiceDate DateTime
  total           Decimal
  currency        String          @default("USD")
  status          RecurringStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())

  items RecurringSupplierInvoiceItem[]
}

model RecurringSupplierInvoiceItem {
  id                         String                   @id @default(uuid())
  recurringSupplierInvoiceId String
  description                String
  quantity                   Decimal
  unitPrice                  Decimal
  total                      Decimal
  recurringSupplierInvoice   RecurringSupplierInvoice @relation(fields: [recurringSupplierInvoiceId], references: [id])
}

model PaymentMade {
  id                String        @id @default(uuid())
  tenantId          String
  number            String        @unique
  supplierId        String
  supplierInvoiceId String?
  date              DateTime
  amount            Decimal
  currency          String        @default("USD")
  method            PaymentMethod
  reference         String?
  notes             String?
  createdAt         DateTime      @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
}

model SupplierCredit {
  id                String           @id @default(uuid())
  tenantId          String
  number            String           @unique
  supplierId        String
  supplierInvoiceId String?
  date              DateTime
  total             Decimal
  status            CreditNoteStatus @default(DRAFT)
  reason            String
  createdAt         DateTime         @default(now())

  items SupplierCreditItem[]
}

model SupplierCreditItem {
  id               String         @id @default(uuid())
  supplierCreditId String
  description      String
  quantity         Decimal
  unitPrice        Decimal
  total            Decimal
  supplierCredit   SupplierCredit @relation(fields: [supplierCreditId], references: [id])
}

model Account {
  id        String      @id @default(uuid())
  tenantId  String
  code      String
  name      String
  type      AccountType
  parentId  String?
  balance   Decimal     @default(0)
  currency  String      @default("USD")
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  parent    Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  Account[]   @relation("AccountHierarchy")

  transactions      Transaction[]
  incomes           Income[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  journalEntryLines JournalEntryLine[]
}

model Income {
  id          String   @id @default(uuid())
  tenantId    String
  number      String   @unique
  accountId   String
  customerId  String?
  date        DateTime
  amount      Decimal
  currency    String   @default("USD")
  category    String
  description String
  reference   String?
  createdAt   DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
}

model Expense {
  id          String        @id @default(uuid())
  tenantId    String
  number      String        @unique
  accountId   String
  supplierId  String?
  date        DateTime
  amount      Decimal
  currency    String        @default("USD")
  category    String
  description String
  reference   String?
  status      ExpenseStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  account Account @relation(fields: [accountId], references: [id])
}

model RecurringExpense {
  id          String          @id @default(uuid())
  tenantId    String
  accountId   String
  supplierId  String?
  frequency   Frequency
  startDate   DateTime
  endDate     DateTime?
  nextDate    DateTime
  amount      Decimal
  currency    String          @default("USD")
  category    String
  description String
  status      RecurringStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id])
}

model JournalEntry {
  id          String        @id @default(uuid())
  tenantId    String
  number      String        @unique
  date        DateTime
  description String
  status      JournalStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  lines JournalEntryLine[]
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0)
  credit         Decimal @default(0)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])

  account Account @relation(fields: [accountId], references: [id])
}

model Transaction {
  id            String          @id @default(uuid())
  tenantId      String
  accountId     String
  date          DateTime
  type          TransactionType
  amount        Decimal
  balance       Decimal
  description   String
  referenceType String?
  referenceId   String?
  createdAt     DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id])
}

model Employee {
  id               String         @id @default(uuid())
  tenantId         String
  code             String
  firstName        String
  lastName         String
  email            String
  phone            String?
  position         String
  department       String
  hireDate         DateTime
  terminationDate  DateTime?
  salary           Decimal
  salaryType       SalaryType
  currency         String         @default("USD")
  bankAccount      String?
  taxId            String?
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  status           EmployeeStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  payrollItems PayrollItem[]
  timeOffs     TimeOff[]
}

model Payroll {
  id              String        @id @default(uuid())
  tenantId        String
  number          String        @unique
  periodStart     DateTime
  periodEnd       DateTime
  payDate         DateTime
  employeeCount   Int
  totalGross      Decimal
  totalDeductions Decimal
  totalNet        Decimal
  currency        String        @default("USD")
  status          PayrollStatus @default(DRAFT)
  createdAt       DateTime      @default(now())

  items PayrollItem[]
}

model PayrollItem {
  id              String  @id @default(uuid())
  payrollId       String
  employeeId      String
  baseSalary      Decimal
  overtime        Decimal @default(0)
  bonuses         Decimal @default(0)
  grossPay        Decimal
  taxDeduction    Decimal @default(0)
  socialSecurity  Decimal @default(0)
  otherDeductions Decimal @default(0)
  totalDeductions Decimal
  netPay          Decimal

  payroll  Payroll  @relation(fields: [payrollId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

model Category {
  id          String     @id @default(uuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  createdAt   DateTime   @default(now())
  // --- LAS LÍNEAS CORREGIDAS ---
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  products Product[]
}

model Product {
  id             String      @id @default(uuid())
  tenantId       String
  code           String      @unique
  name           String
  categoryId     String
  type           ProductType
  cost           Decimal
  price          Decimal
  taxRate        Decimal
  trackInventory Boolean     @default(true)
  createdAt      DateTime    @default(now())

  category Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]
}

model ProductVariant {
  id            String  @id @default(uuid())
  productId     String
  sku           String  @unique
  name          String
  priceModifier Decimal @default(0)
  costModifier  Decimal @default(0)

  product Product @relation(fields: [productId], references: [id])

  inventory          InventoryLevel[]
  inventoryMovements InventoryMovement[]
}

model Warehouse {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  address  String?
  isActive Boolean @default(true)

  inventory          InventoryLevel[]
  inventoryMovements InventoryMovement[]
}

model InventoryLevel {
  id          String  @id @default(uuid())
  warehouseId String
  variantId   String
  quantity    Decimal @default(0)
  reserved    Decimal @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model InventoryMovement {
  id          String       @id @default(uuid())
  tenantId    String
  warehouseId String
  variantId   String
  type        MovementType
  quantity    Decimal
  date        DateTime     @default(now())
  reference   String?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model TimeOff {
  id           String         @id @default(uuid())
  employeeId   String
  type         TimeOffType
  startDate    DateTime
  endDate      DateTime
  status       ApprovalStatus @default(PENDING)
  approvedById String?
  createdAt    DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model Activity {
  id           String       @id @default(uuid())
  tenantId     String
  title        String
  description  String?
  type         ActivityType
  assignedToId String
  dueDate      DateTime?
  status       TaskStatus   @default(PENDING)

  assignedTo User @relation(fields: [assignedToId], references: [id])
}

model Ticket {
  id           String       @id @default(uuid())
  tenantId     String
  number       String       @unique
  subject      String
  description  String
  customerId   String?
  assignedToId String?
  status       TicketStatus @default(OPEN)
  priority     Priority     @default(MEDIUM)
  createdAt    DateTime     @default(now())
}

model Document {
  id           String  @id @default(uuid())
  tenantId     String
  name         String
  url          String
  size         Int
  mimeType     String
  folder       String?
  uploadedById String
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Transfer {
  id       String         @id @default(uuid())
  tenantId String
  number   String         @unique
  fromId   String
  toId     String
  status   TransferStatus @default(PENDING)
  date     DateTime

  items TransferItem[]
}

model TransferItem {
  id         String   @id @default(uuid())
  transferId String
  variantId  String
  quantity   Decimal
  transfer   Transfer @relation(fields: [transferId], references: [id])
}

model Report {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  type        String
  config      Json
  createdById String
  createdAt   DateTime @default(now())
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  permissions Json
}

model SystemSetting {
  id        String   @id @default(uuid())
  tenantId  String
  group     String
  key       String
  value     String
  updatedAt DateTime @updatedAt
}
