// ===== HR MODULE MODELS =====
model Department {
  id              String           @id @default(uuid())
  clientTenantId  String
  code            String
  name            String
  description     String?
  managerId       String?
  parentId        String?
  budget          Decimal?
  status          EntityStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clientTenant    ClientTenant     @relation("DepartmentToClientTenant", fields: [clientTenantId], references: [id])
  manager         Employee?        @relation("DepartmentManager", fields: [managerId], references: [id])
  parent          Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  subDepartments  Department[]     @relation("DepartmentHierarchy")
  employees       Employee[]       @relation("EmployeeDepartment")
  positions       Position[]

  @@unique([clientTenantId, code])
}

model Position {
  id              String           @id @default(uuid())
  clientTenantId  String
  departmentId    String
  code            String
  title           String
  description     String?
  level           String?
  minSalary       Decimal?
  maxSalary       Decimal?
  status          EntityStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clientTenant    ClientTenant     @relation("PositionToClientTenant", fields: [clientTenantId], references: [id])
  department      Department       @relation(fields: [departmentId], references: [id])
  employees       Employee[]       @relation("EmployeePosition")

  @@unique([clientTenantId, code])
}

model Employee {
  id                String                @id @default(uuid())
  clientTenantId    String
  employeeNumber    String                @unique
  firstName         String
  lastName          String
  email             String
  phone             String?
  dateOfBirth       DateTime?
  hireDate          DateTime
  terminationDate   DateTime?
  departmentId      String
  positionId        String
  managerId         String?
  contractType      ContractType
  employmentStatus  EmploymentStatus      @default(ACTIVE)
  salary            Decimal
  currency          String                @default("USD")
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  emergencyContact  String?
  emergencyPhone    String?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  clientTenant      ClientTenant          @relation("EmployeeToClientTenant", fields: [clientTenantId], references: [id])
  department        Department            @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  position          Position              @relation("EmployeePosition", fields: [positionId], references: [id])
  manager           Employee?             @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates      Employee[]            @relation("EmployeeManager")
  managedDepartments Department[]         @relation("DepartmentManager")
  payrolls          Payroll[]             @relation("PayrollEmployee")
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]
  reviews           PerformanceReview[]   @relation("ReviewEmployee")
  reviewsGiven      PerformanceReview[]   @relation("ReviewReviewer")
  trainings         EmployeeTraining[]
  benefits          EmployeeBenefit[]
  documents         EmployeeDocument[]
}

model Payroll {
  id              String           @id @default(uuid())
  clientTenantId  String
  employeeId      String
  periodStart     DateTime
  periodEnd       DateTime
  baseSalary      Decimal
  bonuses         Decimal          @default(0)
  deductions      Decimal          @default(0)
  overtime        Decimal          @default(0)
  grossPay        Decimal
  netPay          Decimal
  taxes           Decimal          @default(0)
  status          String           @default("PENDING")
  paymentDate     DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clientTenant    ClientTenant     @relation("PayrollToClientTenant", fields: [clientTenantId], references: [id])
  employee        Employee         @relation("PayrollEmployee", fields: [employeeId], references: [id])
}

model Attendance {
  id              String              @id @default(uuid())
  clientTenantId  String
  employeeId      String
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  status          AttendanceStatus
  hoursWorked     Decimal?
  overtimeHours   Decimal             @default(0)
  location        String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  clientTenant    ClientTenant        @relation("AttendanceToClientTenant", fields: [clientTenantId], references: [id])
  employee        Employee            @relation(fields: [employeeId], references: [id])
}

model LeaveRequest {
  id                String           @id @default(uuid())
  clientTenantId    String
  employeeId        String
  leaveType         LeaveType
  startDate         DateTime
  endDate           DateTime
  days              Int
  reason            String?
  status            LeaveStatus      @default(PENDING)
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  clientTenant      ClientTenant     @relation("LeaveRequestToClientTenant", fields: [clientTenantId], references: [id])
  employee          Employee         @relation(fields: [employeeId], references: [id])
}

model PerformanceReview {
  id                    String           @id @default(uuid())
  clientTenantId        String
  employeeId            String
  reviewerId            String
  reviewPeriodStart     DateTime
  reviewPeriodEnd       DateTime
  overallRating         Decimal?
  goals                 String?
  achievements          String?
  areasOfImprovement    String?
  comments              String?
  status                ReviewStatus     @default(DRAFT)
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  clientTenant          ClientTenant     @relation("PerformanceReviewToClientTenant", fields: [clientTenantId], references: [id])
  employee              Employee         @relation("ReviewEmployee", fields: [employeeId], references: [id])
  reviewer              Employee         @relation("ReviewReviewer", fields: [reviewerId], references: [id])
}

model Training {
  id              String              @id @default(uuid())
  clientTenantId  String
  title           String
  description     String?
  instructor      String?
  location        String?
  startDate       DateTime
  endDate         DateTime
  capacity        Int
  cost            Decimal?
  currency        String              @default("USD")
  status          TrainingStatus      @default(SCHEDULED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  clientTenant    ClientTenant        @relation("TrainingToClientTenant", fields: [clientTenantId], references: [id])
  enrollments     EmployeeTraining[]
}

model EmployeeTraining {
  id              String           @id @default(uuid())
  employeeId      String
  trainingId      String
  status          TrainingStatus   @default(SCHEDULED)
  completedAt     DateTime?
  score           Decimal?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id])
  training        Training         @relation(fields: [trainingId], references: [id])

  @@unique([employeeId, trainingId])
}

model Benefit {
  id                String              @id @default(uuid())
  clientTenantId    String
  name              String
  description       String?
  type              String
  provider          String?
  cost              Decimal?
  currency          String              @default("USD")
  status            EntityStatus        @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  clientTenant      ClientTenant        @relation("BenefitToClientTenant", fields: [clientTenantId], references: [id])
  employeeBenefits  EmployeeBenefit[]
}

model EmployeeBenefit {
  id              String           @id @default(uuid())
  employeeId      String
  benefitId       String
  startDate       DateTime
  endDate         DateTime?
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id])
  benefit         Benefit          @relation(fields: [benefitId], references: [id])

  @@unique([employeeId, benefitId])
}

model EmployeeDocument {
  id              String           @id @default(uuid())
  clientTenantId  String
  employeeId      String
  title           String
  type            String
  fileUrl         String
  uploadedAt      DateTime         @default(now())
  expiryDate      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clientTenant    ClientTenant     @relation("EmployeeDocumentToClientTenant", fields: [clientTenantId], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id])
}
