generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model NovaHubTenant {
  id        String    @id @default(uuid())
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  partners  Partner[]
}

model Partner {
  id                   String                @id @default(uuid())
  novaHubTenantId      String
  name                 String
  email                String                @unique
  phone                String?
  commissionRate       Decimal               @default(0.10)
  maxClients           Int                   @default(100)
  isActive             Boolean               @default(true)
  baseCurrency         String                @default("NIO")
  exchangeRateAuto     Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accentColor          String?               @default("#064e3b")
  logo                 String?
  primaryColor         String?               @default("#10b981")
  sidebarColor         String?               @default("#0c1a12")
  whiteLabel           Boolean               @default(false)
  clients              ClientTenant[]
  subscriptions        ModuleSubscription[]
  novaHubTenant        NovaHubTenant         @relation(fields: [novaHubTenantId], references: [id])
  subscriptionRequests SubscriptionRequest[]
}

model ClientTenant {
  id                        String                     @id @default(uuid())
  partnerId                 String
  name                      String
  slug                      String                     @unique
  logo                      String?
  primaryColor              String?                    @default("#10b981")
  industry                  IndustryType               @default(OTHER)
  plan                      BillingPlanType            @default(BASIC)
  isActive                  Boolean                    @default(true)
  expiresAt                 DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  accentColor               String?                    @default("#064e3b")
  primaryForeground         String?                    @default("#ffffff")
  sidebarColor              String?                    @default("#0c1a12")
  sidebarForeground         String?                    @default("#f5f5f5")
  whiteLabel                Boolean                    @default(false)
  accounts                  Account[]
  activities                Activity[]
  categories                Category[]
  partner                   Partner                    @relation(fields: [partnerId], references: [id])
  creditNotes               CreditNote[]
  customers                 Customer[]
  documents                 Document[]
  estimates                 Estimate[]
  expenses                  Expense[]
  incomes                   Income[]
  inventoryAdjustments      InventoryAdjustment[]
  inventoryLevels           InventoryLevel[]
  inventoryMovements        InventoryMovement[]
  invoices                  Invoice[]
  journalEntries            JournalEntry[]
  subscriptions             ModuleSubscription[]
  paymentsMade              PaymentMade[]
  paymentsReceived          PaymentReceived[]
  products                  Product[]
  productLots               ProductLot[]
  productSeries             ProductSeries[]
  projects                  Project[]
  purchaseOrders            PurchaseOrder[]
  purchaseReceipts          PurchaseReceipt[]
  recurringExpenses         RecurringExpense[]
  recurringInvoices         RecurringInvoice[]
  recurringSupplierInvoices RecurringSupplierInvoice[]
  reports                   Report[]
  roles                     Role[]
  salesOrders               SalesOrder[]
  salesReturns              SalesReturn[]
  subscriptionRequests      SubscriptionRequest[]
  suppliers                 Supplier[]
  supplierCredits           SupplierCredit[]
  supplierInvoices          SupplierInvoice[]
  systemSettings            SystemSetting[]
  tasks                     Task[]
  tickets                   Ticket[]
  transactions              Transaction[]
  transfers                 Transfer[]
  users                     User[]
  warehouses                Warehouse[]
  departments               Department[]             @relation("DepartmentToClientTenant")
  positions                 Position[]               @relation("PositionToClientTenant")
  hrEmployees               Employee[]               @relation("EmployeeToClientTenant")
  hrPayrolls                Payroll[]                @relation("PayrollToClientTenant")
  attendances               Attendance[]             @relation("AttendanceToClientTenant")
  leaveRequests             LeaveRequest[]           @relation("LeaveRequestToClientTenant")
  performanceReviews        PerformanceReview[]      @relation("PerformanceReviewToClientTenant")
  trainings                 Training[]               @relation("TrainingToClientTenant")
  benefits                  Benefit[]                @relation("BenefitToClientTenant")
  employeeDocuments         EmployeeDocument[]       @relation("EmployeeDocumentToClientTenant")
}

model ModuleSubscription {
  id             String       @id @default(uuid())
  clientTenantId String
  partnerId      String
  module         ModuleType
  isActive       Boolean      @default(true)
  subscribedAt   DateTime     @default(now())
  expiresAt      DateTime?
  notes          String?
  price          Decimal      @default(0)
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
  partner        Partner      @relation(fields: [partnerId], references: [id])

  @@unique([clientTenantId, module])
}

model SubscriptionRequest {
  id              String         @id @default(uuid())
  clientTenantId  String
  partnerId       String
  requestedModule ModuleType
  customPrice     Decimal?
  status          ApprovalStatus @default(PENDING)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clientTenant    ClientTenant   @relation(fields: [clientTenantId], references: [id])
  partner         Partner        @relation(fields: [partnerId], references: [id])
}

model Project {
  id             String         @id @default(uuid())
  clientTenantId String
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  status         DocumentStatus @default(DRAFT)
  budget         Decimal        @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  documents      Document[]
  clientTenant   ClientTenant   @relation(fields: [clientTenantId], references: [id])
  tasks          Task[]
}

model Task {
  id             String       @id @default(uuid())
  projectId      String
  clientTenantId String
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  priority       Priority     @default(MEDIUM)
  dueDate        DateTime?
  assignedToId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
  project        Project      @relation(fields: [projectId], references: [id])
}

model BillingPlan {
  id           String          @id @default(uuid())
  name         String
  type         BillingPlanType
  monthlyPrice Decimal
  modules      ModuleType[]
  maxUsers     Int
  storageLimit Int
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
}

model User {
  id                    String       @id @default(uuid())
  email                 String       @unique
  passwordHash          String
  name                  String
  avatar                String?
  role                  SystemRole   @default(EMPLOYEE)
  isActive              Boolean      @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  clientTenantId        String
  activities            Activity[]
  clientTenant          ClientTenant @relation(fields: [clientTenantId], references: [id])
  responsibleWarehouses Warehouse[]
}

model Customer {
  id                String             @id @default(uuid())
  code              String
  name              String
  type              CustomerType       @default(COMPANY)
  taxId             String?
  email             String?
  phone             String?
  address           String?
  city              String?
  country           String?
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  creditLimit       Decimal            @default(0)
  balance           Decimal            @default(0)
  status            EntityStatus       @default(ACTIVE)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clientTenantId    String
  clientTenant      ClientTenant       @relation(fields: [clientTenantId], references: [id])
  estimates         Estimate[]
  invoices          Invoice[]
  paymentsReceived  PaymentReceived[]
  recurringInvoices RecurringInvoice[]
  salesOrders       SalesOrder[]
  salesReturns      SalesReturn[]
}

model Estimate {
  id             String         @id @default(uuid())
  number         String         @unique
  customerId     String
  date           DateTime
  expiryDate     DateTime
  subtotal       Decimal
  taxAmount      Decimal
  discountAmount Decimal        @default(0)
  total          Decimal
  currency       String         @default("NIO")
  exchangeRate   Decimal        @default(36.5)
  baseTotal      Decimal?
  status         DocumentStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  clientTenantId String
  clientTenant   ClientTenant   @relation(fields: [clientTenantId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  items          EstimateItem[]
}

model EstimateItem {
  id          String   @id @default(uuid())
  estimateId  String
  productId   String?
  description String
  quantity    Decimal
  unitPrice   Decimal
  taxRate     Decimal  @default(0)
  discount    Decimal  @default(0)
  total       Decimal
  estimate    Estimate @relation(fields: [estimateId], references: [id])
}

model SalesOrder {
  id               String           @id @default(uuid())
  number           String           @unique
  customerId       String
  estimateId       String?
  date             DateTime
  expectedDelivery DateTime?
  subtotal         Decimal
  taxAmount        Decimal
  discountAmount   Decimal          @default(0)
  total            Decimal
  currency         String           @default("NIO")
  exchangeRate     Decimal          @default(36.5)
  baseTotal        Decimal?
  status           SalesOrderStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  clientTenantId   String
  invoices         Invoice[]
  clientTenant     ClientTenant     @relation(fields: [clientTenantId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  items            SalesOrderItem[]
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  productId    String?
  description  String
  quantity     Decimal
  unitPrice    Decimal
  taxRate      Decimal    @default(0)
  discount     Decimal    @default(0)
  total        Decimal
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model Invoice {
  id             String            @id @default(uuid())
  number         String            @unique
  customerId     String
  salesOrderId   String?
  date           DateTime
  dueDate        DateTime
  subtotal       Decimal
  taxAmount      Decimal
  discountAmount Decimal           @default(0)
  total          Decimal
  amountPaid     Decimal           @default(0)
  balance        Decimal
  currency       String            @default("NIO")
  exchangeRate   Decimal           @default(36.5)
  baseTotal      Decimal?
  status         PaymentStatus     @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  clientTenantId String
  clientTenant   ClientTenant      @relation(fields: [clientTenantId], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])
  salesOrder     SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  items          InvoiceItem[]
  payments       PaymentReceived[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal
  unitPrice   Decimal
  taxRate     Decimal @default(0)
  discount    Decimal @default(0)
  total       Decimal
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

model RecurringInvoice {
  id              String                 @id @default(uuid())
  customerId      String
  frequency       Frequency
  startDate       DateTime
  endDate         DateTime?
  nextInvoiceDate DateTime
  subtotal        Decimal
  taxAmount       Decimal
  total           Decimal
  currency        String                 @default("NIO")
  exchangeRate    Decimal                @default(36.5)
  baseTotal       Decimal?
  status          RecurringStatus        @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  clientTenantId  String
  clientTenant    ClientTenant           @relation(fields: [clientTenantId], references: [id])
  customer        Customer               @relation(fields: [customerId], references: [id])
  items           RecurringInvoiceItem[]
}

model RecurringInvoiceItem {
  id                 String           @id @default(uuid())
  recurringInvoiceId String
  productId          String?
  description        String
  quantity           Decimal
  unitPrice          Decimal
  taxRate            Decimal          @default(0)
  total              Decimal
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id])
}

model PaymentReceived {
  id             String        @id @default(uuid())
  number         String        @unique
  customerId     String
  invoiceId      String?
  date           DateTime
  amount         Decimal
  currency       String        @default("NIO")
  exchangeRate   Decimal       @default(36.5)
  baseAmount     Decimal?
  method         PaymentMethod
  reference      String?
  notes          String?
  createdAt      DateTime      @default(now())
  clientTenantId String
  clientTenant   ClientTenant  @relation(fields: [clientTenantId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
}

model SalesReturn {
  id             String            @id @default(uuid())
  number         String            @unique
  customerId     String
  invoiceId      String
  date           DateTime
  total          Decimal
  reason         String
  status         ReturnStatus      @default(PENDING)
  createdAt      DateTime          @default(now())
  clientTenantId String
  clientTenant   ClientTenant      @relation(fields: [clientTenantId], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])
  items          SalesReturnItem[]
}

model SalesReturnItem {
  id            String      @id @default(uuid())
  salesReturnId String
  productId     String?
  description   String
  quantity      Decimal
  unitPrice     Decimal
  total         Decimal
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id])
}

model CreditNote {
  id             String           @id @default(uuid())
  number         String           @unique
  customerId     String
  invoiceId      String?
  salesReturnId  String?
  date           DateTime
  total          Decimal
  status         CreditNoteStatus @default(DRAFT)
  reason         String
  createdAt      DateTime         @default(now())
  clientTenantId String
  clientTenant   ClientTenant     @relation(fields: [clientTenantId], references: [id])
  items          CreditNoteItem[]
}

model CreditNoteItem {
  id           String     @id @default(uuid())
  creditNoteId String
  description  String
  quantity     Decimal
  unitPrice    Decimal
  total        Decimal
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id])
}

model Supplier {
  id                        String                     @id @default(uuid())
  code                      String
  name                      String
  taxId                     String?
  email                     String?
  phone                     String?
  address                   String?
  city                      String?
  country                   String?
  contactName               String?
  paymentTerms              String?
  balance                   Decimal                    @default(0)
  rating                    Decimal                    @default(0)
  status                    EntityStatus               @default(ACTIVE)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  clientTenantId            String
  expenses                  Expense[]
  paymentMades              PaymentMade[]
  purchaseOrders            PurchaseOrder[]
  purchaseReceipts          PurchaseReceipt[]
  recurringExpenses         RecurringExpense[]
  recurringSupplierInvoices RecurringSupplierInvoice[]
  clientTenant              ClientTenant               @relation(fields: [clientTenantId], references: [id])
  supplierCredits           SupplierCredit[]
  supplierInvoices          SupplierInvoice[]
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  number           String              @unique
  supplierId       String
  date             DateTime
  expectedDelivery DateTime?
  subtotal         Decimal
  taxAmount        Decimal
  total            Decimal
  currency         String              @default("NIO")
  exchangeRate     Decimal             @default(36.5)
  baseTotal        Decimal?
  status           PurchaseOrderStatus @default(DRAFT)
  requestedBy      String
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  clientTenantId   String
  clientTenant     ClientTenant        @relation(fields: [clientTenantId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  receipts         PurchaseReceipt[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String?
  description     String
  quantity        Decimal
  unitPrice       Decimal
  taxRate         Decimal       @default(0)
  total           Decimal
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model PurchaseReceipt {
  id              String                @id @default(uuid())
  number          String                @unique
  purchaseOrderId String
  supplierId      String
  date            DateTime
  status          ReceiptStatus         @default(PENDING)
  notes           String?
  createdAt       DateTime              @default(now())
  clientTenantId  String
  clientTenant    ClientTenant          @relation(fields: [clientTenantId], references: [id])
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  items           PurchaseReceiptItem[]
}

model PurchaseReceiptItem {
  id                String          @id @default(uuid())
  purchaseReceiptId String
  productId         String?
  description       String
  quantityOrdered   Decimal
  quantityReceived  Decimal
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id])
}

model SupplierInvoice {
  id              String                @id @default(uuid())
  number          String                @unique
  supplierId      String
  purchaseOrderId String?
  date            DateTime
  dueDate         DateTime
  subtotal        Decimal
  taxAmount       Decimal
  total           Decimal
  amountPaid      Decimal               @default(0)
  balance         Decimal
  currency        String                @default("NIO")
  exchangeRate    Decimal               @default(36.5)
  baseTotal       Decimal?
  status          PaymentStatus         @default(PENDING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  clientTenantId  String
  clientTenant    ClientTenant          @relation(fields: [clientTenantId], references: [id])
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  items           SupplierInvoiceItem[]
}

model SupplierInvoiceItem {
  id                String          @id @default(uuid())
  supplierInvoiceId String
  description       String
  quantity          Decimal
  unitPrice         Decimal
  taxRate           Decimal         @default(0)
  total             Decimal
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id])
}

model RecurringSupplierInvoice {
  id              String                         @id @default(uuid())
  supplierId      String
  frequency       Frequency
  startDate       DateTime
  endDate         DateTime?
  nextInvoiceDate DateTime
  total           Decimal
  currency        String                         @default("NIO")
  exchangeRate    Decimal                        @default(36.5)
  baseTotal       Decimal?
  status          RecurringStatus                @default(ACTIVE)
  createdAt       DateTime                       @default(now())
  clientTenantId  String
  clientTenant    ClientTenant                   @relation(fields: [clientTenantId], references: [id])
  supplier        Supplier                       @relation(fields: [supplierId], references: [id])
  items           RecurringSupplierInvoiceItem[]
}

model RecurringSupplierInvoiceItem {
  id                         String                   @id @default(uuid())
  recurringSupplierInvoiceId String
  description                String
  quantity                   Decimal
  unitPrice                  Decimal
  total                      Decimal
  recurringSupplierInvoice   RecurringSupplierInvoice @relation(fields: [recurringSupplierInvoiceId], references: [id])
}

model PaymentMade {
  id                String        @id @default(uuid())
  number            String        @unique
  supplierId        String
  supplierInvoiceId String?
  date              DateTime
  amount            Decimal
  currency          String        @default("NIO")
  exchangeRate      Decimal       @default(36.5)
  baseAmount        Decimal?
  method            PaymentMethod
  reference         String?
  notes             String?
  createdAt         DateTime      @default(now())
  clientTenantId    String
  isActive          Boolean       @default(true)
  clientTenant      ClientTenant  @relation(fields: [clientTenantId], references: [id])
  supplier          Supplier      @relation(fields: [supplierId], references: [id])
}

model SupplierCredit {
  id                String               @id @default(uuid())
  number            String               @unique
  supplierId        String
  supplierInvoiceId String?
  date              DateTime
  total             Decimal
  status            CreditNoteStatus     @default(DRAFT)
  reason            String
  createdAt         DateTime             @default(now())
  clientTenantId    String
  clientTenant      ClientTenant         @relation(fields: [clientTenantId], references: [id])
  supplier          Supplier             @relation(fields: [supplierId], references: [id])
  items             SupplierCreditItem[]
}

model SupplierCreditItem {
  id               String         @id @default(uuid())
  supplierCreditId String
  description      String
  quantity         Decimal
  unitPrice        Decimal
  total            Decimal
  supplierCredit   SupplierCredit @relation(fields: [supplierCreditId], references: [id])
}

model Account {
  id                String             @id @default(uuid())
  code              String
  name              String
  type              AccountType
  parentId          String?
  balance           Decimal            @default(0)
  currency          String             @default("NIO")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  clientTenantId    String
  clientTenant      ClientTenant       @relation(fields: [clientTenantId], references: [id])
  parent            Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[]          @relation("AccountHierarchy")
  expenses          Expense[]
  incomes           Income[]
  journalEntryLines JournalEntryLine[]
  recurringExpenses RecurringExpense[]
  transactions      Transaction[]
}

model Income {
  id             String       @id @default(uuid())
  number         String       @unique
  accountId      String
  date           DateTime
  amount         Decimal
  currency       String       @default("NIO")
  exchangeRate   Decimal      @default(36.5)
  baseAmount     Decimal?
  createdAt      DateTime     @default(now())
  clientTenantId String
  notes          String?
  source         String?
  account        Account      @relation(fields: [accountId], references: [id])
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
}

model Expense {
  id             String        @id @default(uuid())
  number         String        @unique
  accountId      String
  supplierId     String?
  date           DateTime
  amount         Decimal
  currency       String        @default("NIO")
  exchangeRate   Decimal       @default(36.5)
  baseAmount     Decimal?
  category       String
  description    String
  reference      String?
  status         ExpenseStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  clientTenantId String
  account        Account       @relation(fields: [accountId], references: [id])
  clientTenant   ClientTenant  @relation(fields: [clientTenantId], references: [id])
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
}

model RecurringExpense {
  id             String          @id @default(uuid())
  accountId      String
  supplierId     String?
  frequency      Frequency
  startDate      DateTime
  endDate        DateTime?
  amount         Decimal
  currency       String          @default("NIO")
  exchangeRate   Decimal         @default(36.5)
  baseAmount     Decimal?
  category       String?
  description    String
  status         RecurringStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  clientTenantId String
  account        Account         @relation(fields: [accountId], references: [id])
  clientTenant   ClientTenant    @relation(fields: [clientTenantId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
}

model JournalEntry {
  id             String             @id @default(uuid())
  number         String             @unique
  date           DateTime
  description    String
  status         JournalStatus      @default(DRAFT)
  createdAt      DateTime           @default(now())
  clientTenantId String
  clientTenant   ClientTenant       @relation(fields: [clientTenantId], references: [id])
  lines          JournalEntryLine[]
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0)
  credit         Decimal      @default(0)
  description    String?
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
}

model Transaction {
  id             String       @id @default(uuid())
  accountId      String
  date           DateTime
  description    String
  createdAt      DateTime     @default(now())
  clientTenantId String
  credit         Decimal      @default(0)
  debit          Decimal      @default(0)
  reference      String?
  account        Account      @relation(fields: [accountId], references: [id])
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
}

model Category {
  id             String       @id @default(uuid())
  name           String
  description    String?
  parentId       String?
  createdAt      DateTime     @default(now())
  clientTenantId String
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
  parent         Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryHierarchy")
  products       Product[]
}

model Product {
  id                       String                    @id @default(uuid())
  code                     String                    @unique
  name                     String
  categoryId               String
  type                     ProductType               @default(PRODUCT)
  taxRate                  Decimal
  trackInventory           Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  clientTenantId           String
  costPrice                Decimal                   @default(0)
  description              String?
  isActive                 Boolean                   @default(true)
  salePrice                Decimal                   @default(0)
  updatedAt                DateTime                  @updatedAt
  attributes               Json?
  trackBatch               Boolean                   @default(false)
  trackSeries              Boolean                   @default(false)
  inventoryAdjustmentItems InventoryAdjustmentItem[]
  stockLevels              InventoryLevel[]
  movements                InventoryMovement[]
  category                 Category                  @relation(fields: [categoryId], references: [id])
  clientTenant             ClientTenant              @relation(fields: [clientTenantId], references: [id])
  lots                     ProductLot[]
  series                   ProductSeries[]
  variants                 ProductVariant[]
}

model ProductVariant {
  id                       String                    @id @default(uuid())
  productId                String
  sku                      String                    @unique
  name                     String
  priceModifier            Decimal                   @default(0)
  costModifier             Decimal                   @default(0)
  inventoryAdjustmentItems InventoryAdjustmentItem[]
  stockLevels              InventoryLevel[]
  movements                InventoryMovement[]
  product                  Product                   @relation(fields: [productId], references: [id])
  transferItems            TransferItem[]
}

model Warehouse {
  id                   String                @id @default(uuid())
  name                 String
  isActive             Boolean               @default(true)
  clientTenantId       String
  createdAt            DateTime              @default(now())
  location             String?
  layout               Json?
  parentId             String?
  responsibleId        String?
  type                 WarehouseType         @default(MAIN)
  inventoryAdjustments InventoryAdjustment[]
  stockLevels          InventoryLevel[]
  inventoryMovements   InventoryMovement[]
  transfersFrom        Transfer[]            @relation("TransferFrom")
  transfersTo          Transfer[]            @relation("TransferTo")
  clientTenant         ClientTenant          @relation(fields: [clientTenantId], references: [id])
  parent               Warehouse?            @relation("WarehouseHierarchy", fields: [parentId], references: [id])
  children             Warehouse[]           @relation("WarehouseHierarchy")
  responsible          User?                 @relation(fields: [responsibleId], references: [id])
}

model InventoryLevel {
  id                String         @id @default(uuid())
  warehouseId       String
  variantId         String
  quantity          Decimal        @default(0)
  reserved          Decimal        @default(0)
  clientTenantId    String
  maxStock          Decimal?
  minStock          Decimal        @default(0)
  productId         String
  abcClassification String?
  lotId             String?
  predictedDemand   Decimal?
  seriesId          String?
  clientTenant      ClientTenant   @relation(fields: [clientTenantId], references: [id])
  lot               ProductLot?    @relation(fields: [lotId], references: [id])
  product           Product        @relation(fields: [productId], references: [id])
  series            ProductSeries? @relation(fields: [seriesId], references: [id])
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id])
}

model InventoryMovement {
  id             String          @id @default(uuid())
  warehouseId    String
  variantId      String?
  type           MovementType
  quantity       Decimal
  date           DateTime        @default(now())
  reference      String?
  clientTenantId String
  createdAt      DateTime        @default(now())
  productId      String
  lotId          String?
  seriesId       String?
  clientTenant   ClientTenant    @relation(fields: [clientTenantId], references: [id])
  lot            ProductLot?     @relation(fields: [lotId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  series         ProductSeries?  @relation(fields: [seriesId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
}

model Activity {
  id             String       @id @default(uuid())
  title          String
  description    String?
  type           ActivityType
  assignedToId   String
  dueDate        DateTime?
  status         TaskStatus   @default(PENDING)
  clientTenantId String
  createdAt      DateTime     @default(now())
  assignedTo     User         @relation(fields: [assignedToId], references: [id])
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
}

model Ticket {
  id             String       @id @default(uuid())
  number         String       @unique
  subject        String
  description    String
  customerId     String?
  assignedToId   String?
  status         TicketStatus @default(OPEN)
  priority       Priority     @default(MEDIUM)
  createdAt      DateTime     @default(now())
  clientTenantId String
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
}

model Document {
  id             String       @id @default(uuid())
  name           String
  url            String
  size           Int
  mimeType       String
  folder         String?
  uploadedById   String
  clientTenantId String
  projectId      String?
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  timestamp DateTime @default(now())
  type      String   @default("info")
}

model Transfer {
  id               String         @id @default(uuid())
  number           String         @unique
  fromId           String
  toId             String
  status           TransferStatus @default(PENDING)
  date             DateTime
  clientTenantId   String
  carrier          String?
  estimatedArrival DateTime?
  routeData        Json?
  trackingNumber   String?
  clientTenant     ClientTenant   @relation(fields: [clientTenantId], references: [id])
  from             Warehouse      @relation("TransferFrom", fields: [fromId], references: [id])
  to               Warehouse      @relation("TransferTo", fields: [toId], references: [id])
  items            TransferItem[]
}

model TransferItem {
  id         String         @id @default(uuid())
  transferId String
  variantId  String
  quantity   Decimal
  transfer   Transfer       @relation(fields: [transferId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])
}

model Report {
  id             String       @id @default(uuid())
  name           String
  type           String
  config         Json
  createdById    String
  createdAt      DateTime     @default(now())
  clientTenantId String
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
}

model Role {
  id             String       @id @default(uuid())
  name           String
  description    String?
  permissions    Json
  clientTenantId String
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
}

model SystemSetting {
  id             String       @id @default(uuid())
  group          String
  key            String
  value          String
  updatedAt      DateTime     @updatedAt
  clientTenantId String
  clientTenant   ClientTenant @relation(fields: [clientTenantId], references: [id])
}

model ProductLot {
  id              String              @id @default(uuid())
  clientTenantId  String
  productId       String
  number          String
  expirationDate  DateTime?
  manufactureDate DateTime?
  createdAt       DateTime            @default(now())
  stockLevels     InventoryLevel[]
  movements       InventoryMovement[]
  clientTenant    ClientTenant        @relation(fields: [clientTenantId], references: [id])
  product         Product             @relation(fields: [productId], references: [id])
}

model ProductSeries {
  id             String              @id @default(uuid())
  clientTenantId String
  productId      String
  number         String              @unique
  createdAt      DateTime            @default(now())
  stockLevels    InventoryLevel[]
  movements      InventoryMovement[]
  clientTenant   ClientTenant        @relation(fields: [clientTenantId], references: [id])
  product        Product             @relation(fields: [productId], references: [id])
}

model InventoryAdjustment {
  id             String                    @id @default(uuid())
  clientTenantId String
  number         String                    @unique
  date           DateTime
  warehouseId    String
  reason         AdjustmentReason
  notes          String?
  status         DocumentStatus            @default(DRAFT)
  createdAt      DateTime                  @default(now())
  clientTenant   ClientTenant              @relation(fields: [clientTenantId], references: [id])
  warehouse      Warehouse                 @relation(fields: [warehouseId], references: [id])
  items          InventoryAdjustmentItem[]
}

model InventoryAdjustmentItem {
  id           String              @id @default(uuid())
  adjustmentId String
  productId    String
  variantId    String?
  currentStock Decimal
  actualStock  Decimal
  adjustment   InventoryAdjustment @relation(fields: [adjustmentId], references: [id])
  product      Product             @relation(fields: [productId], references: [id])
  variant      ProductVariant?     @relation(fields: [variantId], references: [id])
}


