# Esta URL debe apuntar a una base PostgreSQL exclusiva para E2E.
DATABASE_URL_E2E=postgresql://usuario:clave@localhost:5432/novahub_e2e
E2E_ALLOW_DATABASE_MUTATIONS=1
E2E_ISOLATED_DATABASE=1
E2E_DUAL_FULLSTACK=1
E2E_BACKEND_PORT=3310
E2E_FRONTEND_PORT=5173
E2E_SCHEMA_MODE=datamodel
# E2E_API_URL=http://localhost:3310/api
