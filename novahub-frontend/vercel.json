{
  "routes": [
    {
      "src": "/index\\.html$",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/((?!assets/|maps/|pdf-template-packages/|.*\\.[^/]+$).*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?:assets/.*|maps/.*|pdf-template-packages/.*|.*\\.[^/]+$)",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/((?!assets/|maps/|pdf-template-packages/|.*\\.[^/]+$).*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "dest": "/index.html"
    }
  ]
}
